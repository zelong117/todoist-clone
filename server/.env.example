# Generate a unique value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-unique-secret
PORT=3001
NODE_ENV=development
APP_URL=http://127.0.0.1:5173
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Optional OAuth credentials. Keep these server-only.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=

# Payment webhooks. Configure both values only for a selected production provider.
# The provider sends HMAC-SHA256 over the raw JSON body to /api/billing/webhooks/<provider>.
# PAYMENT_PROVIDER=configured
# PAYMENT_WEBHOOK_SECRET=
