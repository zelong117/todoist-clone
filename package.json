    "test:account-api": "npm --prefix server run test:account-api",
    "test:attachments-api": "npm --prefix server run test:attachments-api",
    "test:db-persistence": "npm --prefix server run test:db-persistence",
    "test:task-version-conflict": "npm --prefix server run test:task-version-conflict",
    "test:auth-sessions": "npm --prefix server run test:auth-sessions",
    "test:websocket-security": "npm --prefix server run test:websocket-security"
                },
