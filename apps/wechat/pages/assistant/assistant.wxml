<view class="page"><text class="eyebrow">AI ASSIST</text><text class="title">Turn a note into a clear plan.</text><textarea value="{{text}}" placeholder="Describe what needs to happen..." bindinput="textInput" maxlength="4000"></textarea><button loading="{{loading}}" disabled="{{!text || loading}}" bindtap="analyze">Suggest tasks</button><view wx:for="{{suggestions}}" wx:key="index" class="suggestion" bindtap="toggle" data-index="{{index}}"><checkbox checked="{{item.selected}}"/><view><text>{{item.title}}</text><text class="meta">{{item.dueDate || 'No date'}} · {{item.priority || 'normal'}}</text></view></view><button wx:if="{{suggestions.length}}" loading="{{saving}}" disabled="{{saving}}" bindtap="createSelected">Create selected tasks</button></view>
