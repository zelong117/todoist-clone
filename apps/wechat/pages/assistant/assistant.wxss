.page { min-height: 100vh; padding: 40rpx 32rpx; background: #fffaf2; color: #17201e; } .eyebrow, .title, .meta { display: block; } .eyebrow { color: #e64b2e; font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; } .title { margin: 10rpx 0 28rpx; font-family: serif; font-size: 46rpx; font-weight: 600; } textarea { box-sizing: border-box; width: 100%; min-height: 220rpx; padding: 22rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } button { margin-top: 22rpx; } .suggestion { display: flex; gap: 16rpx; align-items: flex-start; margin-top: 18rpx; padding: 22rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } .meta { margin-top: 8rpx; color: #758077; font-size: 24rpx; }
