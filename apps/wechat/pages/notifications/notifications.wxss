.page { min-height: 100vh; padding: 40rpx 32rpx; background: #fffaf2; color: #17201e; } .title, .meta { display: block; } .title { font-family: serif; font-size: 48rpx; font-weight: 600; } .item { margin-top: 18rpx; padding: 24rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } .meta { margin-top: 8rpx; color: #758077; font-size: 24rpx; } .empty { padding: 100rpx 0; color: #8c7f74; text-align: center; }
