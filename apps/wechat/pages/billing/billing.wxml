<view class="page"><text class="title">Plan and usage</text><view wx:if="{{loading}}" class="empty">Loading...</view><view wx:elif="{{subscription}}" class="card"><text class="plan">{{subscription.plan}}</text><text>Projects: {{subscription.entitlement.maxProjects}}</text><text>AI requests per day: {{subscription.entitlement.maxAiPerDay}}</text><text wx:if="{{subscription.subscription}}">Status: {{subscription.subscription.status}}</text></view></view>
