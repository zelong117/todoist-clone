.page { min-height: 100vh; padding: 40rpx 32rpx; background: #fffaf2; color: #17201e; } .title, .plan, .card text { display: block; } .title { font-family: serif; font-size: 48rpx; font-weight: 600; } .card { margin-top: 28rpx; padding: 30rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } .plan { margin-bottom: 16rpx; color: #e64b2e; font-size: 34rpx; font-weight: 700; text-transform: uppercase; } .card text { margin-top: 10rpx; color: #536058; } .empty { padding: 100rpx 0; color: #8c7f74; text-align: center; }
