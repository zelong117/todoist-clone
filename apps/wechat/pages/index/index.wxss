.page { min-height: 100vh; padding: 40rpx 32rpx; background: #fffaf2; color: #17201e; } .header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 32rpx; } .eyebrow, .title, .due { display: block; } .eyebrow { color: #e64b2e; font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; } .title { margin-top: 10rpx; font-family: serif; font-size: 52rpx; font-weight: 600; } .tabs { display: flex; gap: 12rpx; margin-bottom: 24rpx; } .tabs button { margin: 0; border: 1rpx solid #ded6ca; background: transparent; color: #5d675f; font-size: 26rpx; } .tabs .selected { border-color: #e64b2e; background: #fff0eb; color: #c84028; } .quick-add { display: flex; gap: 14rpx; margin-bottom: 24rpx; } .quick-add input { min-width: 0; flex: 1; padding: 18rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } .quick-add button { margin: 0; background: #e64b2e; color: #fff; font-size: 26rpx; } .task { display: flex; gap: 20rpx; align-items: flex-start; padding: 28rpx 0; border-bottom: 1rpx solid #e8ddd0; } .complete { flex: 0 0 auto; width: 38rpx; height: 38rpx; margin: 2rpx 0 0; padding: 0; border: 2rpx solid #e64b2e; border-radius: 50%; background: transparent; } .due { color: #8c7f74; font-size: 24rpx; margin-top: 8rpx; } .empty { color: #8c7f74; padding: 100rpx 20rpx; text-align: center; }
