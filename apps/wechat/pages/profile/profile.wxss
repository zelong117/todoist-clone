.page { min-height: 100vh; padding: 40rpx 32rpx; background: #fffaf2; color: #17201e; } .eyebrow, .title, .name, .email, .plan { display: block; } .eyebrow { color: #e64b2e; font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; } .title { margin: 10rpx 0 30rpx; font-family: serif; font-size: 52rpx; font-weight: 600; } .account { padding: 34rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } .name { font-size: 36rpx; font-weight: 700; } .email, .plan { margin-top: 12rpx; color: #69736b; font-size: 26rpx; } button { margin-top: 24rpx; } .secondary { border: 1rpx solid #bdb4a7; background: transparent; color: #4b574f; } .signout { background: #e64b2e; color: #fff; } .empty { padding: 100rpx 20rpx; color: #8c7f74; text-align: center; }
