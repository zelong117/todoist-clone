<view class="page"><text class="eyebrow">ACCOUNT</text><text class="title">My account</text><view wx:if="{{loading}}" class="empty">Syncing...</view><view wx:elif="{{user}}" class="account"><text class="name">{{user.name}}</text><text class="email">{{user.email}}</text><text class="plan">Current plan: {{user.plan || 'free'}}</text></view><button class="secondary" bindtap="openAssistant">AI quick organize</button><button class="secondary" bindtap="openNotifications">Notifications</button><button class="secondary" bindtap="openBilling">Plan and usage</button><button class="signout" bindtap="signOut">Sign out</button></view>
