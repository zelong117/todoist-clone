.page { min-height: 100vh; padding: 40rpx 32rpx; background: #fffaf2; color: #17201e; } .eyebrow, .title { display: block; } .eyebrow { color: #e64b2e; font-size: 20rpx; font-weight: 800; letter-spacing: 3rpx; } .title { margin: 10rpx 0 30rpx; font-family: serif; font-size: 52rpx; font-weight: 600; } .quick-add { display: flex; gap: 14rpx; margin-bottom: 24rpx; } .quick-add input { min-width: 0; flex: 1; padding: 18rpx; border: 1rpx solid #ded6ca; background: #fffdf8; } .quick-add button { margin: 0; background: #e64b2e; color: #fff; font-size: 26rpx; } .project { display: flex; align-items: center; gap: 18rpx; padding: 28rpx 0; border-bottom: 1rpx solid #e8ddd0; } .dot { width: 20rpx; height: 20rpx; border-radius: 50%; } .empty { padding: 100rpx 20rpx; color: #8c7f74; text-align: center; }
