<view class="page"><text class="eyebrow">WORKSPACES</text><text class="title">项目</text><view class="quick-add"><input value="{{name}}" placeholder="新项目名称" bindinput="nameInput" bindconfirm="createProject"/><button loading="{{creating}}" disabled="{{!name || creating}}" bindtap="createProject">新建</button></view><view wx:if="{{loading}}" class="empty">正在同步…</view><view wx:elif="{{projects.length === 0}}" class="empty">还没有项目。</view><view wx:for="{{projects}}" wx:key="id" class="project"><view class="dot" style="background: {{item.color || '#e64b2e'}}"></view><text>{{item.name}}</text></view></view>
